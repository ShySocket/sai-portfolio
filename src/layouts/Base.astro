---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { projects } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Sai Bhandar | Business + CS @ CMU';
const description =
  'Sai Bhandar builds games, computer-vision systems and tools from zero to one. Business + CS at Carnegie Mellon. Selected work: Sidequest, Lazer Shooter, ReliefIQ, Sunrise VR, GyroBlaster.';
const canonical = new URL(base + '/', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}media/sidequest-poster.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <nav class="index" aria-label="Project index">
      {projects.map((p, i) => (
        <a class="index__item" href={`#${p.slug}`} data-index-for={p.slug}>
          <span class="index__label">{String(i + 1).padStart(2, '0')} {p.title}</span>
          <span class="index__dot"></span>
        </a>
      ))}
    </nav>

    <slot />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
