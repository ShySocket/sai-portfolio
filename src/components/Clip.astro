---
// An ink field holding one clip: the well (pinned still under the video), its fixed-cell transport, and a
// caption (the verbatim media label, plus file provenance where there is any).
// The still is a responsive AVIF/WebP <picture> (eager and high priority for the stage, lazy for the rest). The
// video's poster is a transparent pixel, so nothing is fetched twice and the still shows through it.
// Without JS the video keeps native controls over the still and the transport stays out of sight (its cue anchors
// keep their boxes, so /#sidequest-4.5 still lands on the field). JS removes the controls and drives it.
// The frame is named once in every state: the still's alt while it is on screen; the video gets the same label
// (motion.ts) only when it replaces the still, and the caption's copy is aria-hidden.
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { type Clip, cueId, timecode } from '../data/presentation';
import { stillSources } from '../data/stills';

interface Props { project: Project; clip: Clip; lcp?: boolean }
const { project: p, clip, lcp = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const label = p.media.label;
const fallback = p.links[0];
const cuesId = `${p.slug}-cues`;
const provenance = clip.provenance;
const still = await stillSources(clip);
const CLEAR = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<figure
  class="field clip"
  aria-labelledby={`${p.slug}-title`}
  data-clip
  data-title={p.title}
  data-dur={clip.duration}
  data-t={clip.t}
  data-auto={clip.autoplay ? '' : undefined}
>
  <div class="well" data-well>
    <picture>
      <source type="image/avif" srcset={still.avif} sizes={still.sizes} />
      <source type="image/webp" srcset={still.webp} sizes={still.sizes} />
      <img
        class="well__still"
        src={still.src}
        alt={label}
        width={clip.width}
        height={clip.height}
        decoding="async"
        loading={lcp ? 'eager' : 'lazy'}
        fetchpriority={lcp ? 'high' : undefined}
      />
    </picture>
    <video
      class="well__video"
      src={`${base}/${clip.src}`}
      poster={CLEAR}
      preload="none"
      muted
      loop
      playsinline
      controls
      disableremoteplayback
      width={clip.width}
      height={clip.height}
    ></video>
  </div>

  <div class:list={["transport", clip.cueKeys && "transport--cues"]} role="group" aria-label={`${p.title} clip controls`} data-transport data-state="ready">
    <button class="tkey" type="button" aria-label={`Play ${p.title} clip`} data-play>
      {/* One cell, three glyphs: the state crossfades them (global.css), so the key never changes size. */}
      <Icon name="player-play" size={24} class="tkey__i tkey__i--play" />
      <Icon name="player-pause" size={24} class="tkey__i tkey__i--pause" />
      <Icon name="loader-2" size={24} class="tkey__i tkey__i--load" />
    </button>
    <span class="tc"><span data-now>{timecode(clip.t)}</span> / {timecode(clip.duration, false)}</span>
    <span class="state"><Icon name="alert-triangle" size={16} class="state__err" /><span data-word>Ready</span></span>
    {/* The cue keys flank the track (previous before it, next after it) at every width, so the tab order
        (key, previous, ticks, next) is the visual order in the wide row, the narrow row and the 200% layout. */}
    {clip.cueKeys && (
      <button class="cue cue--prev" type="button" aria-label="Previous cue" data-cue="-1"><Icon name="player-skip-back" size={20} /></button>
    )}
    <div class="track">
      <div class="lane" id={cuesId} role="toolbar" aria-label={`${p.title} cues`} data-lane>
        <span class="rail" aria-hidden="true"><span class="fill" data-fill></span></span>
        {clip.cues.map((c) => {
          const caption = c.caption || label;
          const id = cueId(p.slug, c.t);
          return (
            <a
              class="tick"
              id={id}
              href={`#${id}`}
              data-t={c.t}
              data-ring={id}
              style={`--x:${(c.t / clip.duration).toFixed(4)}`}
              tabindex={c.t === clip.t ? 0 : -1}
            >
              <span class="tick__mark" aria-hidden="true"></span>
              <span class="sr">{timecode(c.t)}, {caption}</span>
              <span class="tip" aria-hidden="true"><span class="tip__t">{timecode(c.t)}</span>{caption}</span>
            </a>
          );
        })}
      </div>
      {fallback && (
        <a class="fallback" href={fallback.href} target="_blank" rel="noopener" hidden>
          {fallback.label}<Icon name="arrow-up-right" size={16} /><span class="sr"> (opens in a new tab)</span>
        </a>
      )}
    </div>
    {clip.cueKeys && (
      <button class="cue cue--next" type="button" aria-label="Next cue" data-cue="1"><Icon name="player-skip-forward" size={20} /></button>
    )}
  </div>

  {/* What is on screen, in plain words (media.label, verbatim), then where the footage comes from. The label line
      is the same text as the frame's own name (the still's alt, then the video's label), so it is hidden from
      assistive tech and the label is announced once; the provenance line is read as usual. */}
  <figcaption class="cap">
    <p class="cap__label" aria-hidden="true">{label}</p>
    {provenance && (
      <ul class="cap__facts">
        {provenance.facts.map((f) => <li>{f}</li>)}
        {provenance.full && (
          <li>
            <a class="cap__full" href={`${base}/${provenance.full.src}`} type="video/mp4" target="_blank" rel="noopener">
              {provenance.full.label}<Icon name="arrow-up-right" size={16} /><span class="sr"> (opens in a new tab)</span>
            </a>
          </li>
        )}
      </ul>
    )}
  </figcaption>
</figure>
