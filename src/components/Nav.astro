---
// The address is shown as text beside the copy key wherever the row has room (>= 768px), so it can be read
// and selected in one gesture (user-select: all); the key copies it, and without JS it is a mailto link.
import CopyEmail from './CopyEmail.astro';

const email = 'saib@andrew.cmu.edu';
---

<header class="top">
  <nav class="wrap nav" aria-label="Site">
    <a class="nav__name" href="#top">Sai Bhandar</a>
    <div class="nav__right">
      <a class="nav__link" href="#projects">Projects</a>
      <span class="nav__contact"><span class="nav__mail">{email}</span><CopyEmail size="nav" /></span>
    </div>
  </nav>
</header>
