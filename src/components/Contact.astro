---
const email = 'saib@andrew.cmu.edu';
const year = new Date().getFullYear();
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-label" id="contact-title" data-reveal>Contact</h2>
    <a class="contact__mail" href={`mailto:${email}`} data-reveal>{email}</a>
    <p class="contact__sub" data-reveal>Carnegie Mellon University · Pittsburgh, PA</p>
  </div>
</section>

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">
    <span>&copy; {year} Sai Bhandar</span>
    <a href="#top">Back to top<span aria-hidden="true">&nbsp;&uarr;</span></a>
  </div>
</footer>
