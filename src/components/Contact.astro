---
import CopyEmail from './CopyEmail.astro';

const email = 'saib@andrew.cmu.edu';
---

<section class="close" aria-labelledby="close-title">
  <h2 class="close__mail" id="close-title">
    <a href={`mailto:${email}`} data-email>saib@<wbr /><span class="close__host">andrew.cmu.edu</span></a>
  </h2>
  <div class="close__row">
    <CopyEmail size="lg" />
    {/* Two facts with a drawn hairline between them, like the index kickers: the separator of whichever fact starts a
        line is clipped, so a narrow column never ends or starts a line on a separator. */}
    <ul class="close__where">
      <li>Carnegie Mellon University</li>
      <li>Pittsburgh, PA</li>
    </ul>
  </div>
</section>
