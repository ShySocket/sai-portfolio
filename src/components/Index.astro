---
// The jump index: each row carries the project's own proof at its true aspect, its title, and its
// verbatim kicker drawn as a list with hairline separators (no middots). ReliefIQ carries its award.
// Rows are plain jump links: the underlined title and the hover tint say so, with no disclosure glyph.
import Icon from './Icon.astro';
import { projects } from '../data/projects';
import { presentation } from '../data/presentation';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const glyph = { play: 'player-play', phone: 'device-mobile', movie: 'movie', award: 'award' } as const;
---

<nav class="index" id="projects" aria-label="Projects">
  <ol class="index__list">
    {projects.map((p, i) => {
      const pres = presentation[p.slug];
      return (
        <li>
          <a class="row" href={`#${p.slug}`}>
            <span class="row__cell">
              <img src={`${base}/${pres.thumb.src}`} alt="" width={pres.thumb.width} height={pres.thumb.height} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </span>
            <span class="row__text">
              <span class="row__title">{p.title}</span>
              <ul class="kicker">
                {p.kicker.split(' · ').map((k) => <li>{k}</li>)}
              </ul>
              {p.award && <span class="row__award">{p.award}</span>}
            </span>
            <Icon name={glyph[pres.kind]} size={20} class:list={['row__kind', pres.kind === 'award' && 'row__kind--award']} />
          </a>
        </li>
      );
    })}
  </ol>
</nav>
