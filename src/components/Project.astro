---
import Media from './Media.astro';
import type { Project } from '../data/projects';

interface Props { project: Project; index: number; total: number }
const { project: p, index, total } = Astro.props;
const n = String(index + 1).padStart(2, '0');
---

<article class="project" id={p.slug} data-project={p.slug}>
  <div class="project__text">
    <span class="project__index" data-reveal>{n} / {String(total).padStart(2, '0')}</span>
    <h3 class="project__title" data-reveal>{p.title}</h3>
    <p class="project__kicker" data-reveal>{p.kicker}</p>
    {p.award && (
      <p class="award" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M7 6H4v2a3 3 0 0 0 3 3M17 6h3v2a3 3 0 0 1-3 3"/></svg>
        {p.award}
      </p>
    )}
    <p class="project__summary" data-reveal>{p.summary}</p>
    {p.bullets && (
      <ul class="project__bullets">
        {p.bullets.map((b) => (
          <li data-reveal><b>{b.title}.</b> {b.body}</li>
        ))}
      </ul>
    )}
    <ul class="tags" aria-label="Technologies" data-reveal>
      {p.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    {p.links.length > 0 && (
      <div class="project__links" data-reveal>
        {p.links.map((l) => (
          <a
            class:list={['btn', 'btn--sm', 'magnetic', { 'btn--primary': l.kind === 'play', 'btn--code': l.kind === 'code' }]}
            href={l.href}
            target="_blank"
            rel="noopener"
          >
            {l.label}
            {l.kind === 'code' ? (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
            ) : (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12L12 4M6 4h6v6"/></svg>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
  <div class="project__media">
    <Media media={p.media} title={p.title} live={p.slug === 'sidequest'} />
  </div>
</article>
