---
// One project entry. The layout family follows the media's shape: a wide stage (Sidequest), a portrait
// phone with its QR handoff (Lazer Shooter), a screen spread (ReliefIQ), or one half of a pair (Sunrise,
// GyroBlaster). The media always sits next to the sentence it proves.
import Clip from './Clip.astro';
import EntryText from './EntryText.astro';
import Phone from './Phone.astro';
import Spread from './Spread.astro';
import type { Project } from '../data/projects';
import { presentation } from '../data/presentation';

interface Props { project: Project }
const { project: p } = Astro.props;
const pres = presentation[p.slug];
const family = pres.family;
---

<article class:list={['entry', `entry--${family}`]} id={p.slug}>
  {(family === 'stage' || family === 'pair') && pres.clip && <Clip project={p} clip={pres.clip} lcp={family === 'stage'} />}
  <EntryText project={p} pres={pres} />
  {family === 'phone' && <Phone project={p} />}
  {family === 'spread' && <Spread project={p} />}
</article>
