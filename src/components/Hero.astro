<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__blob hero__blob--a"></div>
    <div class="hero__blob hero__blob--b"></div>
  </div>

  <div class="container hero__inner">
    <p class="hero__eyebrow" data-reveal>Portfolio</p>
    <h1 class="hero__name" data-reveal>Sai Bhandar</h1>
    <p class="hero__tag" data-reveal><b>Business + CS</b> @ CMU</p>
    <div class="hero__cta">
      <a href="#work" class="btn btn--primary magnetic" data-reveal>
        See the work
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4"/></svg>
      </a>
      <a href="#contact" class="btn magnetic" data-reveal>Get in touch</a>
    </div>
  </div>

  <div class="hero__hint" aria-hidden="true" data-reveal>
    <span>Scroll</span>
    <i></i>
  </div>
</section>
