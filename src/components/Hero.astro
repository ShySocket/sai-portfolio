---
import { projects } from '../data/projects';
---

<section class="hero" id="top">
  <div class="container">
    <h1 class="hero__name" data-reveal>Sai Bhandar</h1>
    <p class="hero__tag" data-reveal><b>Business + CS</b> @ CMU</p>

    <nav class="toc" aria-labelledby="toc-label">
      <div class="toc__head" aria-hidden="true">
        <span id="toc-label" class="toc__label">Index</span>
        <span class="toc__col toc__col--kind">What it is</span>
        <span class="toc__col toc__col--stack">Stack</span>
      </div>
      <ol class="toc__list">
        {projects.map((p, i) => (
          <li data-reveal>
            <a class="toc__row" href={`#${p.slug}`}>
              <span class="toc__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="toc__title">{p.title}</span>
              <span class="toc__kind">{p.kicker}</span>
              <span class="toc__stack">{p.tags.slice(0, 3).join(', ')}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>
