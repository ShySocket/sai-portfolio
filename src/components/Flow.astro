---
// A chain from the first note, drawn under the notes: an ordered list of its verbatim phrases (presentation.ts),
// named by the claim it explains. Ink chips are the things that play (the footage in, the level out); the steps
// between are text on the face, and parallel parts hang from their step on a hairline. Vertical by default;
// horizontal where the list has room (a container query on its own width, so 200% text keeps it vertical).
// It is plain markup, so it is complete without JS and in print.
import Icon from './Icon.astro';
import type { FlowStep } from '../data/presentation';

interface Props { steps: FlowStep[]; labelledby: string }
const { steps, labelledby } = Astro.props;
---

<div class="flow">
  <ol class="flow__list" aria-labelledby={labelledby}>
    {steps.map((s, i) => (
      <li class:list={['flow__step', s.kind && `flow__step--${s.kind}`]}>
        {i > 0 && <Icon name="arrow-narrow-down" size={20} class="flow__arrow" />}
        <span class:list={['flow__node', s.kind && 'field']}>{s.text}</span>
        {s.parts && (
          <ul class="flow__parts">
            {s.parts.map((part) => <li>{part}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
</div>
