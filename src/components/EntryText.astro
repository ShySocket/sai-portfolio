---
// One glance order for every family, in two boxes so the proof can sit between them in the DOM:
//   head: title, award, claim, tags, keys      body: summary, notes (with evidence keys)
// Project.astro renders head, media, body: that is the reading and focus order at every width. Where the
// media sits beside the text (wide grids), the body continues under the head in the same column. Whatever the body
// is given (Sidequest's flow) follows the notes inside it, so it stays under them in every layout.
// The claim is the first note's title, verbatim (it stays in its note too).
import Icon from './Icon.astro';
import Keys from './Keys.astro';
import type { Project } from '../data/projects';
import type { Presentation } from '../data/presentation';

interface Props { project: Project; pres: Presentation; part: 'head' | 'body' }
const { project: p, pres, part } = Astro.props;
const claim = p.bullets?.[0]?.title;
---

{part === 'head' ? (
  <div class="entry__head">
    <h2 class="entry__title" id={`${p.slug}-title`}>{p.title}</h2>
    {p.award && (
      <p class="award"><Icon name="award" size={20} class="award__icon" />{p.award}</p>
    )}
    {claim && <p class="claim" id={`${p.slug}-claim`}>{claim}</p>}
    <ul class="tags" aria-label={`${p.title} stack`}>
      {p.tags.map((t) => <li>{t}</li>)}
    </ul>
    <Keys links={p.links} />
  </div>
) : (
  <div class="entry__body">
    <p class="summary">{p.summary}</p>
    {p.bullets && (
      <ul class="notes">
        {p.bullets.map((b) => {
          const proof = pres.proofs?.[b.title];
          return (
            <li class="note" data-proof={proof?.target}>
              <p><b>{b.title}.</b> {b.body}</p>
              {proof && (
                <a class="evkey" href={`#${proof.target}`}>
                  {proof.icon && <Icon name={proof.icon} size={16} />}{proof.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    )}
    <slot />
  </div>
)}
