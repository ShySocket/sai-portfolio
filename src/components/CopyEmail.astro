---
// Without JS: a mailto link reading "Email". With JS (motion.ts) it is replaced by a real <button> named
// "Copy email address" that copies in place: every label shares one grid cell, so the key never resizes.
import Icon from './Icon.astro';

interface Props { size?: 'nav' | 'lg' }
const { size = 'nav' } = Astro.props;
const email = 'saib@andrew.cmu.edu';
---

<a class:list={['copy', `copy--${size}`]} href={`mailto:${email}`} data-copy={email}>
  <span class="copy__stack">
    <span class="copy__l copy__l--idle">
      <span class="copy__nojs"><Icon name="mail" size={20} />Email</span>
      <span class="copy__js"><Icon name="copy" size={20} /><span class="copy__long">Copy email</span><span class="copy__short">Email</span></span>
    </span>
    <span class="copy__l copy__l--done"><Icon name="check" size={20} />Copied</span>
    <span class="copy__l copy__l--fail"><Icon name="alert-triangle" size={20} /><span class="copy__long">Copy failed</span><span class="copy__short">Failed</span></span>
  </span>
</a>
