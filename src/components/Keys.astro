---
// The action row at the title, tiered by what the link proves: a live build you can play (Play in browser, Play on
// your phone) is the filled rose key; a recording (Watch on YouTube) is the outlined key at the same size; the
// source (View code) is an underlined text link. Rose stays on the play keys alone.
import Icon from './Icon.astro';
import type { Link } from '../data/projects';

interface Props { links: Link[] }
const { links } = Astro.props;
const lead = links.filter((l) => l.kind !== 'code');
const code = links.filter((l) => l.kind === 'code');
---

{links.length > 0 && (
  <div class="keys">
    {lead.map((l) => (
      <a class:list={['key', 'key--lead', `key--${l.kind}`]} href={l.href} target="_blank" rel="noopener">
        <span>{l.label}</span><Icon name="arrow-up-right" size={20} /><span class="sr"> (opens in a new tab)</span>
      </a>
    ))}
    {code.map((l) => (
      <a class="key key--code" href={l.href} target="_blank" rel="noopener">
        <span>{l.label}</span><Icon name="arrow-up-right" size={16} /><span class="sr"> (opens in a new tab)</span>
      </a>
    ))}
  </div>
)}
