---
import { Image } from 'astro:assets';
import type { Media } from '../data/projects';

interface Props { media: Media; title: string; fig: number }
const { media, title, fig } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caption = `Fig. ${fig} — ${media.label}`;
const count = media.type === 'video' ? 0 : media.images.length;
---

{media.type === 'video' && (
  <figure class="fig" data-media>
    <div class="fig__frame">
      <div class="media__inner" data-parallax>
        <video
          class="media__el"
          muted
          loop
          playsinline
          preload="metadata"
          poster={`${base}/${media.poster}`}
          aria-label={media.label}
          data-autoplay
        >
          <source src={`${base}/${media.src}`} type="video/mp4" />
        </video>
      </div>
    </div>
    <figcaption class="fig__cap"><span>{caption}</span></figcaption>
  </figure>
)}

{media.type === 'images' && (
  <figure class="fig carousel" data-media data-carousel role="region" aria-roledescription="carousel" aria-label={media.label}>
    <div class="fig__frame">
      <div class="carousel__track" data-lenis-prevent>
        {media.images.map((img, i) => (
          <div class="carousel__slide" role="group" aria-label={`${i + 1} of ${count}`}>
            <Image src={img} alt={media.alts[i]} widths={[640, 960, 1280]} sizes="(min-width: 900px) 720px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} format="webp" quality={78} />
          </div>
        ))}
      </div>
    </div>
    <figcaption class="fig__cap">
      <span>{caption}</span>
      <span class="fig__ctrl">
        <button class="fig__btn" data-prev aria-label={`Previous ${title} image`}>&larr;</button>
        <span class="fig__count" data-count aria-live="polite">1 / {count}</span>
        <button class="fig__btn" data-next aria-label={`Next ${title} image`}>&rarr;</button>
      </span>
    </figcaption>
  </figure>
)}

{media.type === 'phone' && (
  <figure class="fig fig--phone carousel" data-media data-carousel role="region" aria-roledescription="carousel" aria-label={media.label}>
    <div class="fig__stage">
      <div class="phone">
        <div class="phone__screen">
          <div class="carousel__track" data-lenis-prevent>
            {media.images.map((img, i) => (
              <div class="carousel__slide" role="group" aria-label={`${i + 1} of ${count}`}>
                <Image src={img} alt={media.alts[i]} widths={[390, 780]} sizes="260px" loading={i === 0 ? 'eager' : 'lazy'} format="webp" quality={80} />
              </div>
            ))}
          </div>
        </div>
      </div>
      <a class="qr-card" href={media.qrHref} target="_blank" rel="noopener">
        <img src={`${base}/${media.qr}`} alt={`QR code for ${media.qrHref}`} width="150" height="150" loading="lazy" />
        <p>Scan to play on your phone</p>
        <small>{media.qrHref.replace('https://', '')}</small>
      </a>
    </div>
    <figcaption class="fig__cap">
      <span>{caption}</span>
      {count > 1 && (
        <span class="fig__ctrl">
          <button class="fig__btn" data-prev aria-label={`Previous ${title} image`}>&larr;</button>
          <span class="fig__count" data-count aria-live="polite">1 / {count}</span>
          <button class="fig__btn" data-next aria-label={`Next ${title} image`}>&rarr;</button>
        </span>
      )}
    </figcaption>
  </figure>
)}
